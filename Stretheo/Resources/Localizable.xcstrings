    "article.seed.1.content" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stretheo combines Apple Watch biometrics with on-device analysis to estimate stress. Lower heart rate variability, poor sleep, and elevated heart rate can raise your score. Use Measure Now for a fresh reading and track patterns in History."
          }
        }
      }
    },
    "article.seed.1.summary" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn how HRV, sleep, and recovery shape your daily stress index."
          }
        }
      }
    },
    "article.seed.1.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understanding Your Stress Response"
          }
        }
      }
    },
    "article.seed.2.content" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box breathing balances inhale, hold, exhale, and hold again. Practice for two to five minutes when stress rises. Stretheo includes a guided session on the Home tab."
          }
        }
      }
    },
    "article.seed.2.summary" : {
